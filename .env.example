# Ladle configuration. install.sh writes a .env for you with a generated key;
# copy this file if you would rather set values by hand.
#
# SECRET_KEY signs session cookies. Leave it blank to use the built-in
# development default, or generate one with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# true keeps Django's static-file server on (no collectstatic needed).
DJANGO_DEBUG=true
